# ---------------------------------------------------------------------------
# Unity generated folders. Library/ alone is ~2.7 GB of import cache and is
# rebuilt automatically on first open, so it must never be committed.
# ---------------------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta files for folders that are themselves ignored
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---------------------------------------------------------------------------
# IDE / solution files - regenerated by Unity from the project settings
# ---------------------------------------------------------------------------
.vs/
.idea/
.vsconfig
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---------------------------------------------------------------------------
# Build artefacts
# ---------------------------------------------------------------------------
*.apk
*.aab
*.app
*.unitypackage
ExportedObj/
crashlytics-build.properties
sysinfo.txt

# Standalone Windows player builds exported into the project folder
# (CombatPrep1/CombatPrep1.exe + _Data + DirectML.dll, ~126 MB - never commit)
/CombatPrep1/
/cb4/
/cbp3/
*_BurstDebugInformation_DoNotShip/

# ...and the pieces of any other build folder, whatever it gets named
*.exe
UnityPlayer.dll
DirectML.dll
dstorage*.dll
*_Data/
MonoBleedingEdge/
D3D12/

# Unity's crash-recovery copy of an unsaved scene
/Assets/_Recovery/
/Assets/_Recovery.meta

# Mixamo animations may be used in the game but not redistributed as files, so they - and
# the Animator Controller built from them - stay local. See README for how to get them.
/Assets/Art/Characters/Mixamo/
/Assets/Art/Characters/Mixamo.meta

# ---------------------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
